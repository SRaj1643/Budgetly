///////////////////////////////////////////////////////////////
// Budgetly Database Schema (v3.0 - PRODUCTION READY)
//
// Database  : PostgreSQL
// ORM       : Prisma
// Auth      : Better Auth
// Version   : 3.0
//
// UPDATES IN v3.0:
// ✓ Merchant Management (analytics, search, AI insights)
// ✓ Wallet/Account Management (multi-account tracking)
// ✓ Tags System (orthogonal to categories)
// ✓ File Attachments Model (scalable attachment handling)
// ✓ AI Insights (cached AI-generated insights)
// ✓ Bank Sync Infrastructure (Plaid/Yodlee ready)
// ✓ Goal Contributions (immutable contribution history)
// ✓ Budget History (audit trail for budget changes)
// ✓ PostgreSQL Full-Text Search (fast search)
// ✓ Better Auth Integration (v0.5+ compatible)
//
// This schema is organized into:
//
// 1. Prisma Configuration
// 2. Enumerations
// 3. Better Auth Models
// 4. User Preferences & Settings
// 5. Wallet/Account Management
// 6. Merchant Management
// 7. Category Management (with hierarchies)
// 8. Tags System
// 9. Financial Core Models
// 10. File Attachments
// 11. Recurring Transactions
// 12. Goals & Contributions
// 13. Budgets & History
// 14. Alerts & Notifications
// 15. AI Insights & Analytics
// 16. Bank Integration Infrastructure
// 17. Audit Logging
//
///////////////////////////////////////////////////////////////

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////////
//
// ENUMS
//
///////////////////////////////////////////////////////////////

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  BUDGET_ALERT
  GOAL_REMINDER
  RECURRING_TRANSACTION
  AI_INSIGHT
}

enum BudgetAlertStatus {
  WARNING
  CRITICAL
  RESOLVED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum CurrencyCode {
  INR
  USD
  EUR
  GBP
  JPY
  AUD
  CAD
  SGD
  HKD
  CHF
}

enum WalletType {
  CASH
  BANK_ACCOUNT
  CREDIT_CARD
  DEBIT_CARD
  DIGITAL_WALLET
  INVESTMENT
  LOAN
  OTHER
}

enum BankProvider {
  PLAID
  YODLEE
  SALTEDGE
  MANUAL
}

enum AIInsightType {
  SPENDING_TREND
  BUDGET_WARNING
  GOAL_PROGRESS
  ANOMALY_DETECTION
  RECOMMENDATION
  CATEGORY_INSIGHT
}

enum AttachmentType {
  RECEIPT
  INVOICE
  BILL
  PROOF_OF_PAYMENT
  WARRANTY
  DOCUMENT
  IMAGE
  OTHER
}

///////////////////////////////////////////////////////////////
//
// BETTER AUTH MODELS (v0.5+)
//
///////////////////////////////////////////////////////////////

model User {

  /// Primary Key
  id String @id

  /// Basic Information
  name String

  email String @unique

  emailVerified Boolean @default(false)

  image String?

  /// Timestamps
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Better Auth Relations
  ///////////////////////////////////////////////////////////

  accounts Account[]

  sessions Session[]

  ///////////////////////////////////////////////////////////
  // Budgetly Relations
  ///////////////////////////////////////////////////////////

  settings UserSettings?

  categories Category[]

  wallets Wallet[]

  merchants Merchant[]

  transactions Transaction[]

  budgets Budget[]

  budgetHistory BudgetHistory[]

  goals Goal[]

  goalContributions GoalContribution[]

  notifications Notification[]

  recurringTransactions RecurringTransaction[]

  recurringTransactionExecutions RecurringTransactionExecution[]

  budgetAlerts BudgetAlert[]

  spendingStats SpendingStats[]

  auditLogs AuditLog[]

  notificationPreferences NotificationPreference?

  tags Tag[]

  aiInsights AIInsight[]

  bankConnections BankConnection[]

  attachments Attachment[]
}

model Session {

  id String @id

  expiresAt DateTime

  token String @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ipAddress String?

  userAgent String?

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  @@index([userId])
}

model Account {

  id String @id

  accountId String

  providerId String

  userId String

  accessToken String?

  refreshToken String?

  accessTokenExpiresAt DateTime?

  refreshTokenExpiresAt DateTime?

  scope String?

  idToken String?

  password String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  @@index([userId])

  @@unique([providerId, accountId])
}

model Verification {

  id String @id

  identifier String

  value String

  expiresAt DateTime

  createdAt DateTime?

  updatedAt DateTime?

  @@index([identifier])

  @@unique([identifier, value])
}

///////////////////////////////////////////////////////////////
//
// USER PREFERENCES & SETTINGS
//
///////////////////////////////////////////////////////////////

model UserSettings {

  id String @id @default(uuid())

  userId String @unique

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Preferences
  ///////////////////////////////////////////////////////////

  theme Theme @default(SYSTEM)

  languageCode String @default("en")

  currencyCode CurrencyCode @default(INR)

  timezone String @default("Asia/Kolkata")

  dateFormat String @default("DD/MM/YYYY")

  ///////////////////////////////////////////////////////////
  // Notification Preferences
  ///////////////////////////////////////////////////////////

  emailNotifications Boolean @default(true)

  pushNotifications Boolean @default(true)

  budgetAlerts Boolean @default(true)

  goalReminders Boolean @default(true)

  recurringTransactionNotifications Boolean @default(true)

  aiInsightNotifications Boolean @default(true)

  weeklyDigest Boolean @default(true)

  ///////////////////////////////////////////////////////////
  // Voice Preferences
  ///////////////////////////////////////////////////////////

  voiceEnabled Boolean @default(false)

  ///////////////////////////////////////////////////////////
  // Financial Preferences
  ///////////////////////////////////////////////////////////

  budgetAlertThreshold Int @default(80)

  multiCurrencyEnabled Boolean @default(true)

  ///////////////////////////////////////////////////////////
  // Feature Flags
  ///////////////////////////////////////////////////////////

  bankSyncEnabled Boolean @default(false)

  aiInsightsEnabled Boolean @default(true)

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model NotificationPreference {

  id String @id @default(uuid())

  userId String @unique

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  enabledNotificationTypes NotificationType[] @default([INFO, SUCCESS, WARNING, ERROR, BUDGET_ALERT, GOAL_REMINDER, AI_INSIGHT])

  quietHoursStart String?

  quietHoursEnd String?

  minTransactionAmountToNotify Decimal @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

///////////////////////////////////////////////////////////////
//
// WALLET / ACCOUNT MANAGEMENT
//
///////////////////////////////////////////////////////////////

model Wallet {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Wallet Information
  ///////////////////////////////////////////////////////////

  name String

  type WalletType

  currency CurrencyCode @default(INR)

  /// Current balance in wallet (for cash, investment accounts)
  balance Decimal @default(0) @db.Decimal(15, 2)

  /// Whether this wallet is currently active
  isActive Boolean @default(true)

  /// Icon/emoji for UI
  icon String?

  /// Color for UI
  color String? @default("#3B82F6")

  /// Bank/provider name (e.g., "SBI", "HDFC", "Axis")
  provider String?

  /// Account number (masked for security)
  accountNumber String?

  /// Last sync timestamp (if synced from bank)
  lastSyncedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Relations
  ///////////////////////////////////////////////////////////

  transactions Transaction[]

  bankConnection BankConnection?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Constraints & Indexes
  ///////////////////////////////////////////////////////////

  @@unique([userId, name, deletedAt])

  @@index([userId])

  @@index([type])

  @@index([isActive])

  @@index([deletedAt])
}

///////////////////////////////////////////////////////////////
//
// MERCHANT MANAGEMENT
//
///////////////////////////////////////////////////////////////

model Merchant {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Merchant Information
  ///////////////////////////////////////////////////////////

  name String

  /// Website or app identifier
  website String?

  /// Logo URL for UI display
  logo String?

  /// Merchant category (e.g., "Groceries", "Fuel", "Electronics")
  category String?

  /// Merchant identifier from bank sync (if applicable)
  externalMerchantId String?

  ///////////////////////////////////////////////////////////
  // Merchant Metadata
  ///////////////////////////////////////////////////////////

  totalSpent Decimal @default(0) @db.Decimal(15, 2)

  transactionCount Int @default(0)

  lastTransactionDate DateTime?

  ///////////////////////////////////////////////////////////
  // Relations
  ///////////////////////////////////////////////////////////

  transactions Transaction[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Constraints & Indexes
  ///////////////////////////////////////////////////////////

  @@unique([userId, name, deletedAt])

  @@index([userId])

  @@index([category])

  @@index([lastTransactionDate])

  @@index([deletedAt])
}

///////////////////////////////////////////////////////////////
//
// CATEGORY MANAGEMENT (WITH HIERARCHIES)
//
///////////////////////////////////////////////////////////////

model Category {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Category Hierarchy
  ///////////////////////////////////////////////////////////

  parentCategoryId String?

  parentCategory Category?
    @relation(
      "CategoryHierarchy",
      fields: [parentCategoryId],
      references: [id],
      onDelete: SetNull
    )

  subCategories Category[]
    @relation("CategoryHierarchy")

  ///////////////////////////////////////////////////////////
  // Information
  ///////////////////////////////////////////////////////////

  name String

  icon String?

  color String? @default("#3B82F6")

  description String?

  isDefault Boolean @default(false)

  ///////////////////////////////////////////////////////////
  // Relations
  ///////////////////////////////////////////////////////////

  transactions Transaction[]

  budgets Budget[]

  recurringTransactions RecurringTransaction[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Constraints
  ///////////////////////////////////////////////////////////

  @@unique([userId, name, deletedAt])

  @@index([userId])

  @@index([parentCategoryId])

  @@index([deletedAt])
}

///////////////////////////////////////////////////////////////
//
// TAGS SYSTEM (ORTHOGONAL TO CATEGORIES)
//
///////////////////////////////////////////////////////////////

model Tag {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Tag Information
  ///////////////////////////////////////////////////////////

  name String

  color String? @default("#8B5CF6")

  icon String?

  ///////////////////////////////////////////////////////////
  // Relations (Many-to-Many with Transaction)
  ///////////////////////////////////////////////////////////

  transactions TransactionTag[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Constraints
  ///////////////////////////////////////////////////////////

  @@unique([userId, name, deletedAt])

  @@index([userId])

  @@index([deletedAt])
}

/// Junction table for Transaction-Tag many-to-many relationship
model TransactionTag {

  id String @id @default(uuid())

  transactionId String

  transaction Transaction
    @relation(
      fields: [transactionId],
      references: [id],
      onDelete: Cascade
    )

  tagId String

  tag Tag
    @relation(
      fields: [tagId],
      references: [id],
      onDelete: Cascade
    )

  createdAt DateTime @default(now())

  @@unique([transactionId, tagId])

  @@index([transactionId])

  @@index([tagId])
}

///////////////////////////////////////////////////////////////
//
// FINANCIAL CORE MODELS
//
///////////////////////////////////////////////////////////////

model Transaction {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Category
  ///////////////////////////////////////////////////////////

  categoryId String

  category Category
    @relation(
      fields: [categoryId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Merchant
  ///////////////////////////////////////////////////////////

  merchantId String?

  merchant Merchant?
    @relation(
      fields: [merchantId],
      references: [id],
      onDelete: SetNull
    )

  ///////////////////////////////////////////////////////////
  // Wallet
  ///////////////////////////////////////////////////////////

  walletId String

  wallet Wallet
    @relation(
      fields: [walletId],
      references: [id],
      onDelete: Restrict
    )

  ///////////////////////////////////////////////////////////
  // Related Recurring Transaction
  ///////////////////////////////////////////////////////////

  recurringTransactionExecutionId String?

  recurringTransactionExecution RecurringTransactionExecution?
    @relation(
      fields: [recurringTransactionExecutionId],
      references: [id],
      onDelete: SetNull
    )

  ///////////////////////////////////////////////////////////
  // Transaction Details
  ///////////////////////////////////////////////////////////

  title String

  description String?

  amount Decimal @db.Decimal(12, 2)

  type TransactionType

  currency CurrencyCode

  transactionDate DateTime

  ///////////////////////////////////////////////////////////
  // Tags (Many-to-Many)
  ///////////////////////////////////////////////////////////

  tags TransactionTag[]

  ///////////////////////////////////////////////////////////
  // Attachments
  ///////////////////////////////////////////////////////////

  attachments Attachment[]

  ///////////////////////////////////////////////////////////
  // Full-Text Search
  ///////////////////////////////////////////////////////////

  searchVector Unsupported("tsvector")?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Indexes (optimized for analytics & search)
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([categoryId])

  @@index([merchantId])

  @@index([walletId])

  @@index([transactionDate])

  @@index([type])

  @@index([currency])

  @@index([userId, transactionDate])

  @@index([userId, categoryId])

  @@index([userId, type, transactionDate])

  @@index([deletedAt])

  @@fulltext([title, description], map: "transaction_search_idx")
}

///////////////////////////////////////////////////////////////
//
// FILE ATTACHMENTS
//
///////////////////////////////////////////////////////////////

model Attachment {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  transactionId String

  transaction Transaction
    @relation(
      fields: [transactionId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // File Information
  ///////////////////////////////////////////////////////////

  url String

  type AttachmentType @default(RECEIPT)

  mimeType String

  fileName String?

  fileSize Int?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  uploadedAt DateTime @default(now())

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([transactionId])

  @@index([type])

  @@index([uploadedAt])

  @@index([deletedAt])
}

///////////////////////////////////////////////////////////////
//
// RECURRING TRANSACTIONS
//
///////////////////////////////////////////////////////////////

model RecurringTransaction {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  categoryId String

  category Category
    @relation(
      fields: [categoryId],
      references: [id],
      onDelete: Cascade
    )

  walletId String

  ///////////////////////////////////////////////////////////
  // Recurring Details
  ///////////////////////////////////////////////////////////

  title String

  description String?

  amount Decimal @db.Decimal(12, 2)

  type TransactionType

  frequency RecurrenceFrequency

  cronExpression String?

  nextExecution DateTime

  lastExecution DateTime?

  isActive Boolean @default(true)

  endDate DateTime?

  maxOccurrences Int?

  occurrencesGenerated Int @default(0)

  ///////////////////////////////////////////////////////////
  // Execution History
  ///////////////////////////////////////////////////////////

  executions RecurringTransactionExecution[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([nextExecution])

  @@index([isActive])

  @@index([deletedAt])
}

model RecurringTransactionExecution {

  id String @id @default(uuid())

  recurringTransactionId String

  recurringTransaction RecurringTransaction
    @relation(
      fields: [recurringTransactionId],
      references: [id],
      onDelete: Cascade
    )

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  transactions Transaction[]

  executionDate DateTime

  status String @default("completed")

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([recurringTransactionId])

  @@index([userId])

  @@index([executionDate])
}

///////////////////////////////////////////////////////////////
//
// GOALS & GOAL CONTRIBUTIONS
//
///////////////////////////////////////////////////////////////

model Goal {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Goal Information
  ///////////////////////////////////////////////////////////

  title String

  description String?

  targetAmount Decimal @db.Decimal(12, 2)

  /// Denormalized for quick access (sum of contributions)
  currentAmount Decimal @default(0) @db.Decimal(12, 2)

  deadline DateTime?

  status GoalStatus @default(ACTIVE)

  icon String?

  ///////////////////////////////////////////////////////////
  // Goal Contributions (Immutable History)
  ///////////////////////////////////////////////////////////

  contributions GoalContribution[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([status])

  @@index([deletedAt])
}

/// Immutable record of each contribution to a goal
model GoalContribution {

  id String @id @default(uuid())

  goalId String

  goal Goal
    @relation(
      fields: [goalId],
      references: [id],
      onDelete: Cascade
    )

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Contribution Details
  ///////////////////////////////////////////////////////////

  amount Decimal @db.Decimal(12, 2)

  description String?

  ///////////////////////////////////////////////////////////
  // Metadata (Immutable)
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  @@index([goalId])

  @@index([userId])

  @@index([createdAt])
}

///////////////////////////////////////////////////////////////
//
// BUDGETS & BUDGET HISTORY
//
///////////////////////////////////////////////////////////////

model Budget {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  categoryId String?

  category Category?
    @relation(
      fields: [categoryId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Budget Details
  ///////////////////////////////////////////////////////////

  name String

  amount Decimal @db.Decimal(12, 2)

  period BudgetPeriod

  startDate DateTime

  endDate DateTime

  ///////////////////////////////////////////////////////////
  // Budget Alerts
  ///////////////////////////////////////////////////////////

  budgetAlerts BudgetAlert[]

  ///////////////////////////////////////////////////////////
  // Budget History
  ///////////////////////////////////////////////////////////

  history BudgetHistory[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([categoryId])

  @@index([startDate])

  @@index([deletedAt])
}

/// Audit trail for budget changes
model BudgetHistory {

  id String @id @default(uuid())

  budgetId String

  budget Budget
    @relation(
      fields: [budgetId],
      references: [id],
      onDelete: Cascade
    )

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Change Details
  ///////////////////////////////////////////////////////////

  /// Previous amount before change
  previousAmount Decimal @db.Decimal(12, 2)

  /// New amount after change
  newAmount Decimal @db.Decimal(12, 2)

  /// What changed (amount, name, period, dates, etc.)
  changedFields String[]

  /// Reason for change (optional)
  reason String?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  @@index([budgetId])

  @@index([userId])

  @@index([createdAt])
}

///////////////////////////////////////////////////////////////
//
// ALERTS & NOTIFICATIONS
//
///////////////////////////////////////////////////////////////

model BudgetAlert {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  budgetId String

  budget Budget
    @relation(
      fields: [budgetId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Alert Details
  ///////////////////////////////////////////////////////////

  status BudgetAlertStatus @default(WARNING)

  amountSpent Decimal @db.Decimal(12, 2)

  percentageUsed Int

  message String

  isDismissed Boolean @default(false)

  dismissedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([budgetId])

  @@index([status])

  @@index([isDismissed])
}

model Notification {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Notification Content
  ///////////////////////////////////////////////////////////

  title String

  body String

  type NotificationType

  actionUrl String?

  metadata Json?

  isRead Boolean @default(false)

  readAt DateTime?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([isRead])

  @@index([type])

  @@index([createdAt])
}

///////////////////////////////////////////////////////////////
//
// AI INSIGHTS & ANALYTICS
//
///////////////////////////////////////////////////////////////

model AIInsight {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Insight Details
  ///////////////////////////////////////////////////////////

  type AIInsightType

  /// Summary/title of insight
  summary String

  /// Detailed explanation
  description String?

  /// Insight data (contextual - varies by type)
  metadata Json?

  /// Whether user has dismissed this insight
  isDismissed Boolean @default(false)

  dismissedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  generatedAt DateTime @default(now())

  createdAt DateTime @default(now())

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([type])

  @@index([isDismissed])

  @@index([generatedAt])
}

model SpendingStats {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  /// Year-Month format: "2024-01"
  period String

  ///////////////////////////////////////////////////////////
  // Aggregated Data
  ///////////////////////////////////////////////////////////

  totalIncome Decimal @default(0) @db.Decimal(12, 2)

  totalExpense Decimal @default(0) @db.Decimal(12, 2)

  netAmount Decimal @default(0) @db.Decimal(12, 2)

  transactionCount Int @default(0)

  topCategories Json?

  topMerchants Json?

  averageTransactionAmount Decimal @default(0) @db.Decimal(12, 2)

  largestTransaction Decimal @default(0) @db.Decimal(12, 2)

  budgetUtilizationPercent Int @default(0)

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@unique([userId, period])

  @@index([userId])

  @@index([period])
}

///////////////////////////////////////////////////////////////
//
// BANK INTEGRATION INFRASTRUCTURE
//
///////////////////////////////////////////////////////////////

model BankConnection {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  walletId String

  wallet Wallet
    @relation(
      fields: [walletId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Bank Connection Details
  ///////////////////////////////////////////////////////////

  provider BankProvider @default(MANUAL)

  /// External identifier from provider (Plaid account ID, etc.)
  externalAccountId String?

  /// Encrypted access credentials (store carefully!)
  encryptedCredentials String?

  /// Bank name
  bankName String?

  accountType String?

  ///////////////////////////////////////////////////////////
  // Sync Details
  ///////////////////////////////////////////////////////////

  isActive Boolean @default(true)

  lastSyncedAt DateTime?

  nextSyncAt DateTime?

  syncStatus String @default("idle")

  lastSyncError String?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  disconnectedAt DateTime?

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@unique([walletId])

  @@index([userId])

  @@index([provider])

  @@index([isActive])
}

///////////////////////////////////////////////////////////////
//
// AUDIT LOGGING
//
///////////////////////////////////////////////////////////////

model AuditLog {

  id String @id @default(uuid())

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Audit Details
  ///////////////////////////////////////////////////////////

  action String

  entityType String

  entityId String

  changes Json?

  ipAddress String?

  userAgent String?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([entityType])

  @@index([entityId])

  @@index([action])

  @@index([createdAt])
}