///////////////////////////////////////////////////////////////
// Budgetly Database Schema
//
// Database  : PostgreSQL
// ORM       : Prisma
// Auth      : Better Auth
// Version   : 1.0
//
// This schema is organized into:
//
// 1. Prisma Configuration
// 2. Enumerations
// 3. Better Auth Models
// 4. Budgetly Models
//
///////////////////////////////////////////////////////////////

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

///////////////////////////////////////////////////////////////
//
// ENUMS
//
///////////////////////////////////////////////////////////////

enum Theme {
  LIGHT
  DARK
  SYSTEM
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BudgetPeriod {
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

///////////////////////////////////////////////////////////////
//
// BETTER AUTH MODELS
//
///////////////////////////////////////////////////////////////

model User {

  /// Primary Key
  id String @id

  /// Basic Information
  name String

  email String @unique

  emailVerified Boolean @default(false)

  image String?

  /// Timestamps
  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Better Auth Relations
  ///////////////////////////////////////////////////////////

  accounts Account[]

  sessions Session[]

  ///////////////////////////////////////////////////////////
  // Budgetly Relations
  ///////////////////////////////////////////////////////////

  settings UserSettings?

  categories Category[]

  transactions Transaction[]

  budgets Budget[]

  goals Goal[]

  notifications Notification[]

  recurringTransactions RecurringTransaction[]
}

model Session {

  id String @id

  expiresAt DateTime

  token String @unique

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ipAddress String?

  userAgent String?

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  @@index([userId])
}

model Account {

  id String @id

  accountId String

  providerId String

  userId String

  accessToken String?

  refreshToken String?

  accessTokenExpiresAt DateTime?

  refreshTokenExpiresAt DateTime?

  scope String?

  idToken String?

  password String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  @@index([userId])

  @@unique([providerId, accountId])
}

model Verification {

  id String @id

  identifier String

  value String

  expiresAt DateTime

  createdAt DateTime?

  updatedAt DateTime?

  @@index([identifier])

  @@unique([identifier, value])
}

///////////////////////////////////////////////////////////////
//
// BUDGETLY BUSINESS MODELS
//
///////////////////////////////////////////////////////////////

model UserSettings {

  ///////////////////////////////////////////////////////////
  // Primary Key
  ///////////////////////////////////////////////////////////

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Relations
  ///////////////////////////////////////////////////////////

  userId String @unique

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Preferences
  ///////////////////////////////////////////////////////////

  theme Theme @default(SYSTEM)

  languageCode String @default("en")

  currencyCode String @default("INR")

  timezone String @default("Asia/Kolkata")

  dateFormat String @default("DD/MM/YYYY")

  ///////////////////////////////////////////////////////////
  // Notification Preferences
  ///////////////////////////////////////////////////////////

  emailNotifications Boolean @default(true)

  pushNotifications Boolean @default(true)

  budgetAlerts Boolean @default(true)

  goalReminders Boolean @default(true)

  ///////////////////////////////////////////////////////////
  // Voice Preferences
  ///////////////////////////////////////////////////////////

  voiceEnabled Boolean @default(false)

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model Category {

  ///////////////////////////////////////////////////////////
  // Primary Key
  ///////////////////////////////////////////////////////////

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Ownership
  ///////////////////////////////////////////////////////////

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Information
  ///////////////////////////////////////////////////////////

  name String

  icon String?

  color String?

  isDefault Boolean @default(false)

  ///////////////////////////////////////////////////////////
  // Relations
  ///////////////////////////////////////////////////////////

  transactions Transaction[]

  budgets Budget[]

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Constraints
  ///////////////////////////////////////////////////////////

  @@unique([userId, name])

  @@index([userId])
}

///////////////////////////////////////////////////////////////
//
// FINANCIAL CORE MODELS
//
///////////////////////////////////////////////////////////////

model Transaction {

  ///////////////////////////////////////////////////////////
  // Primary Key
  ///////////////////////////////////////////////////////////

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Ownership
  ///////////////////////////////////////////////////////////

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Category
  ///////////////////////////////////////////////////////////

  categoryId String

  category Category
    @relation(
      fields: [categoryId],
      references: [id]
    )

  ///////////////////////////////////////////////////////////
  // Transaction Details
  ///////////////////////////////////////////////////////////

  title String

  description String?

  amount Decimal @db.Decimal(12,2)

  type TransactionType

  transactionDate DateTime

  ///////////////////////////////////////////////////////////
  // Optional Attachment
  ///////////////////////////////////////////////////////////

  receiptUrl String?

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([categoryId])

  @@index([transactionDate])

  @@index([type])

  @@index([userId, transactionDate])

  @@index([userId, categoryId])
}

///////////////////////////////////////////////////////////////

model Budget {

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Ownership
  ///////////////////////////////////////////////////////////

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Optional Category Budget
  ///////////////////////////////////////////////////////////

  categoryId String?

  category Category?
    @relation(
      fields: [categoryId],
      references: [id]
    )

  ///////////////////////////////////////////////////////////
  // Budget Details
  ///////////////////////////////////////////////////////////

  amount Decimal @db.Decimal(12,2)

  period BudgetPeriod

  startDate DateTime

  endDate DateTime

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([categoryId])

  @@index([startDate])
}

///////////////////////////////////////////////////////////////

model Goal {

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Ownership
  ///////////////////////////////////////////////////////////

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Goal Information
  ///////////////////////////////////////////////////////////

  title String

  description String?

  targetAmount Decimal @db.Decimal(12,2)

  currentAmount Decimal @default(0) @db.Decimal(12,2)

  deadline DateTime?

  status GoalStatus @default(ACTIVE)

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([status])
}

///////////////////////////////////////////////////////////////

model Notification {

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Ownership
  ///////////////////////////////////////////////////////////

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Notification Content
  ///////////////////////////////////////////////////////////

  title String

  body String

  type NotificationType

  actionUrl String?

  metadata Json?

  isRead Boolean @default(false)

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([isRead])

  @@index([type])
}

///////////////////////////////////////////////////////////////

model RecurringTransaction {

  id String @id @default(uuid())

  ///////////////////////////////////////////////////////////
  // Ownership
  ///////////////////////////////////////////////////////////

  userId String

  user User
    @relation(
      fields: [userId],
      references: [id],
      onDelete: Cascade
    )

  ///////////////////////////////////////////////////////////
  // Category
  ///////////////////////////////////////////////////////////

  categoryId String

  category Category
    @relation(
      fields: [categoryId],
      references: [id]
    )

  ///////////////////////////////////////////////////////////
  // Recurring Details
  ///////////////////////////////////////////////////////////

  title String

  description String?

  amount Decimal @db.Decimal(12,2)

  type TransactionType

  cronExpression String

  nextExecution DateTime

  isActive Boolean @default(true)

  ///////////////////////////////////////////////////////////
  // Metadata
  ///////////////////////////////////////////////////////////

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  ///////////////////////////////////////////////////////////
  // Indexes
  ///////////////////////////////////////////////////////////

  @@index([userId])

  @@index([nextExecution])

  @@index([isActive])
}

